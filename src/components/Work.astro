---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].work;
const vizData = Object.fromEntries(t.projects.map((p) => [p.id, p.viz]));
---

<section id="work" class="section">
  <div class="wrap">
    <p class="kicker">{t.kicker}</p>
    <h2 class="section-title">{t.title}</h2>
    <p class="lede">{t.intro}</p>

    <div class="explorer" data-explorer data-viz={JSON.stringify(vizData)} data-lang={lang}>
      <ul class="cards">
        {
          t.projects.map((p) => (
            <li>
              <button type="button" class="card" data-open={p.id} aria-haspopup="dialog">
                <span class="org mono">
                  {p.org} · {p.years}
                </span>
                <span class="head mono">{p.headline}</span>
                <span class="name">{p.title}</span>
                <span class="teaser">{p.teaser}</span>
                <span class="go mono">{t.open} →</span>
              </button>
            </li>
          ))
        }
      </ul>

      <dialog class="modal" aria-labelledby="work-modal-title">
        {
          t.projects.map((p) => (
            <article data-panel={p.id} hidden>
              <header>
                <p class="org mono">
                  {p.org} · {p.years}
                </p>
                <h3 id={`title-${p.id}`}>{p.title}</h3>
              </header>
              <div class="stage viz-stage" data-stage />
              {p.id !== 'docAi' && <p class="synthetic mono">{t.illustrative}</p>}
              <p class="summary">{p.summary}</p>
              <dl class="metrics">
                {p.metrics.map((m) => (
                  <div>
                    <dt class="metric-value">{m.value}</dt>
                    <dd class="metric-label">{m.label}</dd>
                  </div>
                ))}
              </dl>
              <footer>
                <ul class="chips">
                  {p.methods.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
                {p.links?.map((l) => (
                  <a class="more" href={l.href} data-close {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                    {l.label} →
                  </a>
                ))}
              </footer>
            </article>
          ))
        }
        <button type="button" class="close mono" data-close aria-label={t.close}>Esc ✕</button>
      </dialog>
    </div>
  </div>
</section>

<script>
  import { RENDERERS } from '../scripts/workViz';

  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    const viz = JSON.parse(root.dataset.viz!);
    const lang = root.dataset.lang!;
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
    const ids = [...root.querySelectorAll<HTMLElement>('[data-panel]')].map((p) => p.dataset.panel!);
    let cleanup: () => void = () => {};
    let opener: HTMLElement | null = null;

    function open(id: string) {
      cleanup();
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
      dialog.setAttribute('aria-labelledby', `title-${id}`);
      if (!dialog.open) dialog.showModal();
      dialog.scrollTop = 0;
      const stage = root.querySelector<HTMLElement>(`[data-panel="${id}"] [data-stage]`)!;
      stage.replaceChildren();
      cleanup = RENDERERS[id](stage, viz[id], lang);
    }

    dialog.addEventListener('close', () => {
      cleanup();
      cleanup = () => {};
      opener?.focus();
    });
    // click on the backdrop (outside the dialog box) closes it
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).closest('[data-close]')) dialog.close();
    });
    root.querySelectorAll<HTMLElement>('[data-open]').forEach((card) =>
      card.addEventListener('click', () => {
        opener = card;
        open(card.dataset.open!);
      }),
    );
    // links elsewhere on the page (e.g. the Path timeline) can open a specific project
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLElement>('[data-goto]');
      if (link?.dataset.goto && ids.includes(link.dataset.goto)) {
        e.preventDefault();
        opener = link;
        open(link.dataset.goto);
      }
    });
  });
</script>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
    height: 100%;
    text-align: left;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.1rem 1.2rem 1rem;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, transform 0.15s;
  }

  .card:hover {
    border-color: var(--accent);
    background: var(--surface-2);
    transform: translateY(-2px);
  }

  .org {
    font-size: 0.72rem;
    color: var(--faint);
    margin: 0;
  }

  .head {
    font-size: 1.45rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--accent);
    margin-top: 0.3rem;
  }

  .name {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .teaser {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--muted);
    flex: 1;
  }

  .go {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--faint);
    transition: color 0.15s;
  }

  .card:hover .go {
    color: var(--accent);
  }

  .stage {
    position: relative;
    min-height: 15rem;
  }

  .synthetic {
    margin: 0.5rem 0 0;
    font-size: 0.7rem;
    color: var(--faint);
  }

  .summary {
    color: var(--muted);
    font-size: 0.96rem;
    margin: 1rem 0 0;
    max-width: 62ch;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2rem;
    margin: 1.1rem 0 0;
    padding-top: 1rem;
    border-top: 1px dashed var(--line-strong);
  }

  .metrics div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .metrics dd {
    margin: 0;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.1rem;
  }

  .more {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .card {
      padding: 0.95rem 1rem 0.85rem;
    }
    .head {
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
  }
</style>
