---
import { content, type Lang } from '../i18n/content';
import ArbCalc from './ArbCalc.astro';
import ThesisModel from './ThesisModel.astro';
import Ifrs9 from './Ifrs9.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].work;
const research = content[lang].research;
const vizData = Object.fromEntries(t.projects.map((p) => [p.id, p.viz]));
// documents and outside sites open in a new tab so the page (and an open dialog) stays put
const ext = (href: string) => (href.startsWith('#') ? {} : { target: '_blank', rel: 'noopener' });

// one list for production work and research, ordered by impact
const ORDER = ['origination', 'thesis', 'surebets', 'ifrs9', 'fraud', 'docAi', 'valuation', 'tobit'];
type Card = {
  key: string;
  kind: 'project' | 'pub';
  eyebrow: string;
  title: string;
  headline: string;
  teaser: string;
  links: { label: string; href: string }[];
  out: { label: string; href: string }[];
};
const outLinks = (ls: { label: string; href: string }[]) => ls.filter((l) => l.href.startsWith('http') || l.href.endsWith('.pdf')).slice(0, 2);
const cards: Card[] = ORDER.map((key) => {
  const p = t.projects.find((x) => x.id === key);
  if (p) return { key, kind: 'project', eyebrow: `${p.org} · ${p.years}`, title: p.title, headline: p.headline, teaser: p.teaser, links: p.links ?? [], out: outLinks(p.links ?? []) };
  const r = research.items.find((x) => x.viz === key)!;
  return { key, kind: 'pub', eyebrow: r.kind, title: r.title, headline: r.headline, teaser: r.short, links: r.links, out: outLinks(r.links) };
});

// small static previews drawn at build time; the interactive versions open in the dialog
const rand = (seed: number) => () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const line = (pts: [number, number][]) => 'M' + pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L');
const r = rand(11);
const thesis = Array.from({ length: 14 }, (_, i) => {
  const hi = i % 2 === 0;
  let y = hi ? 0.55 + r() * 0.15 : 0.45 - r() * 0.1;
  return {
    hi,
    d: line(Array.from({ length: 12 }, (_, k) => {
      y = Math.min(0.98, Math.max(0.04, y + (hi ? 0.025 : -0.012) + (r() - 0.5) * 0.08));
      return [6 + k * 19.3, 94 - y * 88];
    })),
  };
});
const gauss = (x: number, m: number, s: number) => Math.exp(-((x - m) ** 2) / (2 * s * s));
const xs = Array.from({ length: 61 }, (_, k) => k / 60);
const density = line(xs.map((x) => [30 + x * 160, 92 - gauss(x, 0.66, x < 0.66 ? 0.11 : 0.07) * 70]));
const legit = line(xs.map((x) => [12 + x * 200, 92 - gauss(x, 0.32, 0.11) * 72]));
const fraud = line(xs.map((x) => [12 + x * 200, 92 - gauss(x, 0.68, 0.11) * 56]));
const roc = (lift: number) => line(xs.map((x) => [16 + x * 192, 92 - (1 - (1 - x) ** lift) * 76]));
const pd = (k: number) => line(xs.map((x) => [16 + x * 192, 92 - k * x ** 1.15 * 76]));
const sb = rand(5);
let level = 1.03;
const odds = line(Array.from({ length: 40 }, (_, k) => {
  level += (sb() - 0.5) * 0.014 + (k === 27 ? -0.03 : 0) + (k === 31 ? 0.03 : 0);
  return [12 + k * 5.1, 50 - (level - 1) * 900];
}));
---

<section id="work" class="section">
  <div class="wrap">
    <div class="head-row">
      <div>
        <p class="kicker">{t.kicker}</p>
        <h2 class="section-title">{t.title}</h2>
      </div>
      <div class="arrows" data-arrows hidden>
        <button type="button" data-dir="-1" aria-label={t.prev}>←</button>
        <button type="button" data-dir="1" aria-label={t.next}>→</button>
      </div>
    </div>

    <div class="explorer" data-explorer data-viz={JSON.stringify(vizData)} data-lang={lang}>
      <ol class="cards" data-track>
        {
          cards.map((c) => (
            <li class="card">
              <p class="eyebrow mono">{c.eyebrow}</p>
              <h3>{c.title}</h3>
              <div class="preview" aria-hidden="true">
                {c.key === 'origination' && (
                  <svg viewBox="0 0 224 100">
                    <path d={roc(2.2)} class="s-blue" />
                    <path d={roc(3.4)} class="s-amber" />
                    <line x1="96" x2="96" y1="10" y2="92" class="dash" />
                    <line x1="16" x2="208" y1="92" y2="92" class="axis" />
                  </svg>
                )}
                {c.key === 'ifrs9' && (
                  <svg viewBox="0 0 224 100">
                    <path d={pd(0.55)} class="s-blue" />
                    <path d={pd(0.95)} class="s-amber" />
                    <line x1="16" x2="208" y1="92" y2="92" class="axis" />
                  </svg>
                )}
                {c.key === 'surebets' && (
                  <svg viewBox="0 0 224 100">
                    <rect x="12" y="50" width="200" height="42" class="zone" />
                    <line x1="12" x2="212" y1="50" y2="50" class="dash" />
                    <path d={odds} class="s-blue" />
                  </svg>
                )}
                {c.key === 'fraud' && (
                  <svg viewBox="0 0 224 100">
                    <path d={`${legit}L212,92L12,92Z`} class="f-blue" />
                    <path d={`${fraud}L212,92L12,92Z`} class="f-amber" />
                    <line x1="112" x2="112" y1="8" y2="92" class="thr" />
                    <line x1="12" x2="212" y1="92" y2="92" class="axis" />
                  </svg>
                )}
                {c.key === 'docAi' && (
                  <svg viewBox="0 0 224 100">
                    <rect x="16" y="22" width="192" height="18" rx="4" class="bar-dim" />
                    <rect x="16" y="22" width="14.4" height="18" rx="4" class="bar-amber" />
                    <rect x="16" y="60" width="192" height="18" rx="4" class="bar-amber" />
                    <rect x="16" y="60" width="48" height="18" rx="4" class="bar-blue" />
                  </svg>
                )}
                {c.key === 'valuation' && (
                  <svg viewBox="0 0 224 100">
                    {[54, 68, 61].map((h, i) => (
                      <rect x={40 + i * 52} y={92 - h} width="34" height={h} rx="4" class={i === 2 ? 'bar-amber' : 'bar-blue'} />
                    ))}
                    <line x1="16" x2="208" y1="92" y2="92" class="axis" />
                  </svg>
                )}
                {c.key === 'thesis' && (
                  <svg viewBox="0 0 224 100" preserveAspectRatio="none">
                    {thesis.map((l) => <path d={l.d} class={l.hi ? 'l2' : 'l1'} />)}
                  </svg>
                )}
                {c.key === 'tobit' && (
                  <svg viewBox="0 0 224 100">
                    <path d={`${density}L190,92L30,92Z`} class="f-amber" />
                    <path d={density} class="s-amber" />
                    <line x1="18" x2="18" y1="92" y2="58" class="spike" />
                    <circle cx="18" cy="58" r="3.5" class="dot" />
                    <line x1="204" x2="204" y1="92" y2="48" class="spike" />
                    <circle cx="204" cy="48" r="3.5" class="dot" />
                    <line x1="10" x2="214" y1="92" y2="92" class="axis" />
                  </svg>
                )}
              </div>
              <p class="headline">{c.headline}</p>
              <p class="teaser">{c.teaser}</p>
              <button type="button" class="more" data-open={c.key} aria-haspopup="dialog">
                <span class="sr-only">{t.open}: {c.title}</span>
              </button>
              {c.out.length > 0 && (
              <div class="foot">
                <p class="links">
                  {c.out.map((l) => (
                      <a href={l.href} {...ext(l.href)}>
                        {/github\.com/.test(l.href) ? 'GitHub' : l.label} ↗
                      </a>
                    ))}
                </p>
              </div>
              )}
            </li>
          ))
        }
      </ol>

      <dialog class="modal">
        {
          t.projects.map((p) => (
            <article data-panel={p.id} data-kind="project" hidden>
              <header>
                <p class="modal-eyebrow mono">
                  {p.org} · {p.years}
                </p>
                <h3 id={`title-${p.id}`}>{p.title}</h3>
              </header>
              {p.id === 'ifrs9' ? (
                <div class="embed">
                  <Ifrs9 lang={lang} />
                </div>
              ) : (
                <div class="stage viz-stage" data-stage />
              )}
              {p.id !== 'docAi' && <p class="synthetic mono">{t.illustrative}</p>}
              {p.deep ? (
                <div class="story">{p.deep.story.map((x) => <p>{x}</p>)}</div>
              ) : (
                <p class="summary">{p.summary}</p>
              )}
              <dl class="metrics">
                {p.metrics.map((m) => (
                  <div>
                    <dt class="metric-value">{m.value}</dt>
                    <dd class="metric-label">{m.label}</dd>
                  </div>
                ))}
              </dl>
              {p.deep && (
                <ul class="docs">
                  {p.deep.docs.map((d) => (
                    <li>
                      <a href={d.href} target="_blank" rel="noopener">
                        <img src={d.img} alt={d.caption} loading="lazy" />
                      </a>
                      <span class="mono">{d.caption}</span>
                    </li>
                  ))}
                </ul>
              )}
              {p.id === 'surebets' && <ArbCalc lang={lang} />}
              <footer>
                <ul class="chips">
                  {p.methods.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
                <span class="more-links">
                  {p.links?.map((l) => (
                    <a class="more-link" href={l.href} {...ext(l.href)}>
                      {l.label} →
                    </a>
                  ))}
                </span>
              </footer>
            </article>
          ))
        }
        {
          research.items
            .filter((r) => r.viz)
            .map((r) => (
              <article data-panel={r.viz} data-kind="pub" hidden>
                <header>
                  <p class="modal-eyebrow mono">{r.kind}</p>
                  <h3 id={`title-${r.viz}`}>{r.title}</h3>
                </header>
                <p class="authors">
                  {r.authors} · <em>{r.venue}</em>
                </p>
                <div class="viz-stage" data-research-viz={r.viz} data-labels={JSON.stringify(r.vizLabels)} />
                {r.vizLabels?.note && <p class="synthetic mono">{r.vizLabels.note}</p>}
                {r.deep ? (
                  <div class="story">{r.deep.story.map((x) => <p>{x}</p>)}</div>
                ) : (
                  <p class="summary">{r.summary}</p>
                )}
                {r.viz === 'thesis' && <ThesisModel lang={lang} />}
                {r.deep && (
                  <ul class="docs">
                    {r.deep.docs.map((d) => (
                      <li>
                        <a href={d.href} target="_blank" rel="noopener">
                          <img src={d.img} alt={d.caption} loading="lazy" />
                        </a>
                        <span class="mono">{d.caption}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <footer>
                  <span class="more-links">
                    {r.links.map((l) => (
                      <a class="more-link" href={l.href} {...ext(l.href)}>
                        {l.label} →
                      </a>
                    ))}
                  </span>
                </footer>
              </article>
            ))
        }
        <button type="button" class="close mono" data-close aria-label={t.close}>Esc ✕</button>
      </dialog>
    </div>
  </div>
</section>

<script>
  import { RENDERERS } from '../scripts/workViz';
  import { RESEARCH_VIZ } from '../scripts/researchViz';

  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    const viz = JSON.parse(root.dataset.viz!);
    const lang = root.dataset.lang!;
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
    const ids = [...root.querySelectorAll<HTMLElement>('[data-panel]')].map((p) => p.dataset.panel!);
    const renderedPubs = new Set<string>();
    let cleanup: () => void = () => {};
    let opener: HTMLElement | null = null;

    function open(id: string) {
      cleanup();
      cleanup = () => {};
      const panel = root.querySelector<HTMLElement>(`[data-panel="${id}"]`)!;
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p !== panel));
      dialog.setAttribute('aria-labelledby', `title-${id}`);
      if (!dialog.open) dialog.showModal();
      dialog.scrollTop = 0;
      const stage = panel.querySelector<HTMLElement>('[data-stage]');
      if (panel.dataset.kind === 'project' && stage) {
        stage.replaceChildren();
        cleanup = RENDERERS[id](stage, viz[id], lang);
      } else if (!renderedPubs.has(id)) {
        // research figures keep their state between openings
        const stage = panel.querySelector<HTMLElement>('[data-research-viz]')!;
        RESEARCH_VIZ[id](stage, JSON.parse(stage.dataset.labels!), lang);
        renderedPubs.add(id);
      }
    }

    dialog.addEventListener('close', () => {
      cleanup();
      cleanup = () => {};
      opener?.focus();
    });
    // a click on the backdrop (outside the dialog box) or on an in-page link closes it; documents open in a new tab
    dialog.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (e.target === dialog || el.closest('[data-close]') || el.closest('a[href^="#"]')) dialog.close();
    });
    root.querySelectorAll<HTMLElement>('[data-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        opener = btn.closest('.card')!.querySelector('.more');
        open(btn.dataset.open!);
      }),
    );
    // links elsewhere on the page (e.g. the Path timeline) can open a specific project
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLElement>('[data-goto]');
      if (link?.dataset.goto && ids.includes(link.dataset.goto)) {
        e.preventDefault();
        opener = link;
        open(link.dataset.goto);
      }
    });

    // the cards sit in one row that scrolls sideways; arrows step through it
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const arrows = root.closest('section')!.querySelector<HTMLElement>('[data-arrows]')!;
    const [prev, next] = arrows.querySelectorAll<HTMLButtonElement>('button');
    const sync = () => {
      arrows.hidden = track.scrollWidth <= track.clientWidth + 2;
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
    };
    [prev, next].forEach((b) =>
      b.addEventListener('click', () => {
        // one page at a time: as many whole cards as fit
        const step = track.querySelector<HTMLElement>('.card')!.offsetWidth + 14;
        const perPage = Math.max(1, Math.floor((track.clientWidth + 14) / step));
        track.scrollBy({ left: +b.dataset.dir! * perPage * step, behavior: 'smooth' });
      }),
    );
    track.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(track);
  });
</script>

<style>
  .head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .arrows {
    display: flex;
    flex: none;
    gap: 0.5rem;
    margin-bottom: 2.75rem;
  }

  .arrows[hidden] {
    display: none;
  }

  .arrows button {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    font: inherit;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    cursor: pointer;
  }

  .arrows button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* a single row that scrolls sideways; the next card peeks in so it's clear there is more */
  .cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * 0.9rem) / 3.4);
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0 0 0.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  .card {
    scroll-snap-align: start;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    padding: 1.1rem 1.1rem 0.95rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.15s;
  }

  .card:hover {
    border-color: var(--line-strong);
  }

  .card:hover .preview {
    border-color: var(--accent);
  }

  .card:has(.more:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .eyebrow {
    font-size: 0.7rem;
    color: var(--faint);
    margin: 0 0 0.45rem;
  }

  .card h3 {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.8rem;
    min-height: 2.6em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .preview {
    display: block;
    width: 100%;
    height: 6.4rem;
    padding: 0.5rem 0.6rem;
    margin: 0 0 0.85rem;
    border-radius: 10px;
    background: var(--bg);
    border: 1px solid var(--line);
    transition: border-color 0.15s;
  }

  .preview svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .s-blue,
  .s-amber,
  .l1,
  .l2 {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .s-blue {
    stroke: #3987e5;
  }

  .s-amber {
    stroke: var(--accent);
  }

  .l1,
  .l2 {
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }

  .l1 {
    stroke: rgba(57, 135, 229, 0.55);
  }

  .l2 {
    stroke: rgba(242, 165, 65, 0.55);
  }

  .f-blue {
    fill: rgba(57, 135, 229, 0.35);
    stroke: #3987e5;
    stroke-width: 1.2;
  }

  .f-amber {
    fill: rgba(242, 165, 65, 0.22);
    stroke: var(--accent);
    stroke-width: 1.2;
  }

  .bar-blue {
    fill: #3987e5;
  }

  .bar-amber {
    fill: var(--accent);
  }

  .bar-dim {
    fill: var(--surface-2);
  }

  .zone {
    fill: rgba(127, 207, 154, 0.1);
  }

  .axis {
    stroke: var(--line-strong);
  }

  .dash {
    stroke: var(--muted);
    stroke-dasharray: 3 3;
  }

  .thr {
    stroke: var(--text);
    stroke-width: 1.5;
  }

  .spike {
    stroke: #3987e5;
    stroke-width: 3;
  }

  .dot {
    fill: #3987e5;
  }

  .headline {
    margin: 0 0 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.98rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .teaser {
    margin: 0 0 0.9rem;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--muted);
    flex: 1;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .links {
    display: flex;
    gap: 0.8rem;
    margin: 0;
    white-space: nowrap;
  }

  .links a {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent);
    text-decoration: none;
  }

  /* the whole card is the open button; the outbound links sit above it */
  .more {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .more:focus-visible {
    outline: none;
  }

  .foot {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }

  .links a {
    pointer-events: auto;
  }

  .stage {
    position: relative;
    min-height: 15rem;
  }

  .story {
    max-width: 44rem;
    margin: 1rem 0 0;
  }

  .story p {
    margin: 0 0 0.85rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .docs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0.5rem;
  }

  .docs li {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .docs a {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: #f4f2ee;
    transition: border-color 0.15s;
  }

  .docs a:hover {
    border-color: var(--accent);
  }

  .docs img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .docs span {
    font-size: 0.7rem;
    color: var(--faint);
    line-height: 1.4;
  }

  /* the dialog already carries the project title */
  .embed :global(.ifrs h3) {
    display: none;
  }

  .embed :global(.ifrs) {
    border: 0;
    padding: 0;
    margin: 0;
    background: none;
  }

  .synthetic {
    margin: 0.5rem 0 0;
    font-size: 0.7rem;
    color: var(--faint);
  }

  .authors {
    font-size: 0.85rem;
    color: var(--faint);
    margin: -0.4rem 0 1rem;
  }

  .authors em {
    color: var(--muted);
  }

  .summary {
    color: var(--muted);
    font-size: 0.96rem;
    margin: 1rem 0 0;
    max-width: 62ch;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2rem;
    margin: 1.1rem 0 0;
    padding-top: 1rem;
    border-top: 1px dashed var(--line-strong);
  }

  .metrics div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .metrics dd {
    margin: 0;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.1rem;
