---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].nav;
const otherHref = lang === 'en' ? '/es/' : '/';
const otherLang = lang === 'en' ? 'es' : 'en';
const items = [
  ['#work', t.work],
  ['#research', t.research],
  ['#lab', t.lab],
  ['#path', t.path],
  ['#contact', t.contact],
] as const;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="name" href={lang === 'en' ? '/' : '/es/'}>Fernando Cortés</a>
    <nav aria-label="Main">
      <ul>
        {items.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
      <a class="lang mono" href={otherHref} hreflang={otherLang} lang={otherLang} aria-label={t.switchAria}>{t.switchLabel}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(11, 14, 19, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.4vw, 1.8rem);
  }

  ul {
    display: flex;
    gap: clamp(0.9rem, 2.4vw, 1.8rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul a {
    font-size: 0.92rem;
    color: var(--muted);
    text-decoration: none;
  }

  ul a:hover {
    color: var(--text);
  }

  .lang {
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    padding: 0.15rem 0.45rem;
  }

  @media (max-width: 720px) {
    ul li:not(:last-child) {
      display: none;
    }
  }
</style>
