---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].research;
const isExternal = (href: string) => href.startsWith('http');
const ext = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {});

// small static previews for the cards; the interactive versions open in the dialog
const rand = (seed: number) => () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const r = rand(11);
const thesisLines = Array.from({ length: 14 }, (_, i) => {
  const hi = i % 2 === 0;
  let y = hi ? 0.55 + r() * 0.15 : 0.45 - r() * 0.1;
  const pts = Array.from({ length: 12 }, (_, k) => {
    y += (hi ? 0.025 : -0.012) + (r() - 0.5) * 0.08;
    y = Math.min(0.98, Math.max(0.04, y));
    return `${6 + k * 19.3},${(94 - y * 88).toFixed(1)}`;
  });
  return { d: 'M' + pts.join('L'), hi };
});
const density = Array.from({ length: 61 }, (_, k) => {
  const x = k / 60;
  const y = Math.exp(-((x - 0.66) ** 2) / 0.018) * (x < 0.66 ? 1 : 0.7 + 0.3 * Math.exp(-((x - 0.66) ** 2) / 0.006));
  return `${30 + x * 160},${(92 - y * 70).toFixed(1)}`;
});
---

<section id="research" class="section">
  <div class="wrap">
    <div class="head-row">
      <div>
        <p class="kicker">{t.kicker}</p>
        <h2 class="section-title">{t.title}</h2>
      </div>
      <div class="arrows" data-arrows hidden>
        <button type="button" data-dir="-1" aria-label={t.prev}>←</button>
        <button type="button" data-dir="1" aria-label={t.next}>→</button>
      </div>
    </div>

    <ol class="track" data-track>
      {
        t.items.map((p, i) => (
          <li class="pub">
            <p class="kind mono">{p.kind}</p>
            <h3>{p.title}</h3>
            <div class="preview" aria-hidden="true">
              {i === 0 && (
                <div class="big">
                  <span class="mono">100+</span>
                  <small>
                    {lang === 'en' ? 'citations · Expert Systems with Applications' : 'citas · Expert Systems with Applications'}
                  </small>
                </div>
              )}
              {p.viz === 'thesis' && (
                <svg viewBox="0 0 224 100" preserveAspectRatio="none">
                  {thesisLines.map((l) => (
                    <path d={l.d} class={l.hi ? 'l2' : 'l1'} />
                  ))}
                </svg>
              )}
              {p.viz === 'tobit' && (
                <svg viewBox="0 0 224 100">
                  <path d={`M30,92L${density.join('L')}L190,92Z`} class="area" />
                  <path d={`M${density.join('L')}`} class="curve" />
                  <line x1="18" x2="18" y1="92" y2="58" class="spike" />
                  <circle cx="18" cy="58" r="3.5" class="spike-dot" />
                  <line x1="204" x2="204" y1="92" y2="48" class="spike" />
                  <circle cx="204" cy="48" r="3.5" class="spike-dot" />
                  <line x1="10" x2="214" y1="92" y2="92" class="axis" />
                </svg>
              )}
            </div>
            <p class="headline">{p.headline}</p>
            <p class="short">{p.short}</p>
            <div class="foot">
              <p class="links">
                {p.links.slice(0, 2).map((l) => (
                  <a href={l.href} {...ext(l.href)}>
                    {l.label} ↗
                  </a>
                ))}
              </p>
              <button type="button" class="more" data-open-pub={i} aria-haspopup="dialog">
                {p.viz ? t.explore : t.more} <span aria-hidden="true">+</span>
              </button>
            </div>
          </li>
        ))
      }
    </ol>

    <dialog class="modal" data-pub-dialog>
      {
        t.items.map((p, i) => (
          <article data-pub={i} hidden>
            <header>
              <p class="modal-eyebrow mono">{p.kind}</p>
              <h3>{p.title}</h3>
            </header>
            <p class="authors">
              {p.authors} · <em>{p.venue}</em>
            </p>
            {p.viz && (
              <>
                <div class="viz-stage" data-research-viz={p.viz} data-labels={JSON.stringify(p.vizLabels)} />
                {p.vizLabels?.note && <p class="fig-note mono">{p.vizLabels.note}</p>}
              </>
            )}
            <p class="summary">{p.summary}</p>
            <p class="links">
              {p.links.map((l) => (
                <a href={l.href} {...ext(l.href)}>
                  {l.label} ↗
                </a>
              ))}
            </p>
          </article>
        ))
      }
      <button type="button" class="close mono" data-close aria-label={t.close}>Esc ✕</button>
    </dialog>
  </div>
</section>

<script>
  import { RESEARCH_VIZ } from '../scripts/researchViz';
  const lang = document.documentElement.lang;

  // carousel: arrows only when the cards overflow the row
  const track = document.querySelector<HTMLElement>('[data-track]')!;
  const arrows = document.querySelector<HTMLElement>('[data-arrows]')!;
  const buttons = [...arrows.querySelectorAll<HTMLButtonElement>('button')];
  const sync = () => {
    const overflow = track.scrollWidth > track.clientWidth + 2;
    arrows.hidden = !overflow;
    buttons[0].disabled = track.scrollLeft < 4;
    buttons[1].disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
  };
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const card = track.querySelector<HTMLElement>('.pub')!;
      track.scrollBy({ left: +b.dataset.dir! * (card.offsetWidth + 16), behavior: 'smooth' });
    }),
  );
  track.addEventListener('scroll', sync, { passive: true });
  new ResizeObserver(sync).observe(track);

  // details dialog; figures render on first open and keep their state afterwards
  const dialog = document.querySelector<HTMLDialogElement>('[data-pub-dialog]')!;
  const rendered = new Set<string>();
  let opener: HTMLElement | null = null;
  document.querySelectorAll<HTMLElement>('[data-open-pub]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const key = btn.dataset.openPub!;
      opener = btn;
      dialog.querySelectorAll<HTMLElement>('[data-pub]').forEach((a) => (a.hidden = a.dataset.pub !== key));
      dialog.showModal();
      dialog.scrollTop = 0;
      const stage = dialog.querySelector<HTMLElement>(`[data-pub="${key}"] [data-research-viz]`);
      if (stage && !rendered.has(key)) {
        RESEARCH_VIZ[stage.dataset.researchViz!](stage, JSON.parse(stage.dataset.labels!), lang);
        rendered.add(key);
      }
    }),
  );
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || (e.target as HTMLElement).closest('[data-close]')) dialog.close();
  });
  dialog.addEventListener('close', () => opener?.focus());
</script>

<style>
  .head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .arrows {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.4rem;
  }

  .arrows[hidden] {
    display: none;
  }

  .arrows button {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    font: inherit;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    cursor: pointer;
  }

  .arrows button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(19rem, 1fr);
    gap: 1rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0 0 0.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  .pub {
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    padding: 1.3rem 1.3rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
  }

  .kind {
    font-size: 0.72rem;
    color: var(--faint);
    margin: 0 0 0.5rem;
  }

  .pub h3 {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .preview {
    display: grid;
    place-items: center;
    height: 7.5rem;
    margin-bottom: 0.9rem;
    border-radius: 10px;
    background: var(--bg);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .preview svg {
    width: 100%;
    height: 100%;
    padding: 0.6rem 0.8rem;
  }

  .big {
    text-align: center;
  }

  .big span {
    display: block;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.03em;
  }

  .big small {
    font-size: 0.75rem;
    color: var(--faint);
  }

  .l1,
  .l2,
  .curve {
    fill: none;
    stroke-width: 1.4;
  }

  .l1,
  .l2 {
    vector-effect: non-scaling-stroke;
  }

  .l1 {
    stroke: rgba(57, 135, 229, 0.55);
  }

  .l2 {
    stroke: rgba(242, 165, 65, 0.55);
  }

  .curve {
    stroke: var(--accent);
    stroke-width: 2;
  }

  .area {
    fill: rgba(242, 165, 65, 0.16);
  }

  .spike {
    stroke: #3987e5;
    stroke-width: 3;
  }

  .spike-dot {
    fill: #3987e5;
  }

  .axis {
    stroke: var(--line-strong);
  }

  .headline {
    margin: 0 0 0.3rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--accent);
  }

  .short {
    margin: 0 0 1rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--muted);
    flex: 1;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0;
  }

  .links a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
  }

  .more {
    flex: none;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .more span {
    display: inline-grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    margin-left: 0.3rem;
    border-radius: 50%;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
  }

  .more:hover {
    color: var(--accent);
  }

  .authors {
    font-size: 0.85rem;
    color: var(--faint);
    margin: -0.4rem 0 1rem;
  }

  .authors em {
    color: var(--muted);
  }

  .fig-note {
    margin: 0.6rem 0 0;
    font-size: 0.7rem;
    color: var(--faint);
  }

  .summary {
    margin: 1rem 0;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 62ch;
  }

  @media (max-width: 700px) {
    .track {
      grid-auto-columns: 82%;
    }
  }
</style>
