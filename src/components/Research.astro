---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].research;
const isExternal = (href: string) => href.startsWith('http');
const paperStats =
  lang === 'en'
    ? [
        ['100+', 'citations'],
        ['80,000', 'users in two countries'],
        ['Elsevier', 'Expert Systems with Applications'],
      ]
    : [
        ['100+', 'citas'],
        ['80,000', 'usuarios en dos países'],
        ['Elsevier', 'Expert Systems with Applications'],
      ];
---

<section id="research" class="section">
  <div class="wrap">
    <p class="kicker">{t.kicker}</p>
    <h2 class="section-title">{t.title}</h2>

    <ol class="pubs">
      {
        t.items.map((p, i) => (
          <li class="pub">
            <div class="text">
              <p class="kind mono">
                {p.kind}
                {p.badge && <span class="badge">{p.badge}</span>}
              </p>
              <h3>{p.title}</h3>
              <p class="authors">
                {p.authors} · <em>{p.venue}</em>
              </p>
              <p class="summary">{p.summary}</p>
              <p class="links">
                {p.links.map((l) => (
                  <a href={l.href} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener' } : {})}>
                    {l.label} ↗
                  </a>
                ))}
              </p>
            </div>
            {p.viz ? (
              <button type="button" class="peek" data-open-fig={p.viz} aria-haspopup="dialog">
                <span class="peek-kind mono">{t.figure}</span>
                <span class="peek-title">{p.vizLabels?.title}</span>
                <span class="peek-note">{p.vizLabels?.note}</span>
                <span class="peek-go mono">{t.explore} →</span>
              </button>
            ) : (
              i === 0 && (
                <dl class="stats">
                  {paperStats.map(([v, l]) => (
                    <div>
                      <dt class="mono">{v}</dt>
                      <dd>{l}</dd>
                    </div>
                  ))}
                </dl>
              )
            )}
          </li>
        ))
      }
    </ol>

    <dialog class="modal" data-fig-dialog>
      {
        t.items.filter((p) => p.viz).map((p) => (
          <article data-fig={p.viz} hidden>
            <header>
              <p class="modal-eyebrow mono">{p.kind}</p>
              <h3>{p.vizLabels?.title}</h3>
            </header>
            <div class="viz-stage" data-research-viz={p.viz} data-labels={JSON.stringify(p.vizLabels)} />
            {p.vizLabels?.note && <p class="fig-note mono">{p.vizLabels.note}</p>}
            <p class="fig-summary">{p.summary}</p>
          </article>
        ))
      }
      <button type="button" class="close mono" data-close aria-label={t.close}>Esc ✕</button>
    </dialog>
  </div>
</section>

<script>
  import { RESEARCH_VIZ } from '../scripts/researchViz';
  const lang = document.documentElement.lang;
  const dialog = document.querySelector<HTMLDialogElement>('[data-fig-dialog]')!;
  let opener: HTMLElement | null = null;
  // figures render on first open; they keep their state if reopened
  const rendered = new Set<string>();
  document.querySelectorAll<HTMLElement>('[data-open-fig]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const key = btn.dataset.openFig!;
      opener = btn;
      dialog.querySelectorAll<HTMLElement>('[data-fig]').forEach((a) => (a.hidden = a.dataset.fig !== key));
      dialog.showModal();
      dialog.scrollTop = 0;
      if (!rendered.has(key)) {
        const stage = dialog.querySelector<HTMLElement>(`[data-fig="${key}"] [data-research-viz]`)!;
        RESEARCH_VIZ[key](stage, JSON.parse(stage.dataset.labels!), lang);
        rendered.add(key);
      }
    }),
  );
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || (e.target as HTMLElement).closest('[data-close]')) dialog.close();
  });
  dialog.addEventListener('close', () => opener?.focus());
</script>

<style>
  .pubs {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }

  .pub {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }

  .kind {
    font-size: 0.76rem;
    color: var(--faint);
    margin: 0 0 0.8rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .badge {
    color: var(--accent-ink);
    background: var(--accent);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-weight: 600;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    line-height: 1.15;
    margin: 0 0 0.6rem;
  }

  .authors {
    font-size: 0.85rem;
    color: var(--faint);
    margin: 0 0 0.8rem;
  }

  .authors em {
    color: var(--muted);
  }

  .summary {
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
  }

  .links a {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--accent);
    text-decoration: none;
  }

  .peek {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    text-align: left;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.3rem 1.4rem;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }

  .peek:hover {
    border-color: var(--accent);
    background: var(--surface-2);
  }

  .peek-kind {
    font-size: 0.72rem;
    color: var(--faint);
  }

  .peek-title {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .peek-note {
    font-size: 0.88rem;
    color: var(--muted);
  }

  .peek-go {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--accent);
  }

  .fig-note {
    margin: 0.6rem 0 0;
    font-size: 0.7rem;
    color: var(--faint);
  }

  .fig-summary {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 62ch;
  }

  .fig {
    margin: 0;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
  }

  .fig figcaption {
    margin-top: 0.6rem;
    font-size: 0.7rem;
    color: var(--faint);
  }

  .stats {
    display: grid;
    gap: 1.4rem;
    margin: 0;
    padding-left: clamp(1rem, 3vw, 2.5rem);
    border-left: 1px solid var(--line);
  }

  .stats dt {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.03em;
  }

  .stats div:not(:first-child) dt {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    color: var(--text);
  }

  .stats dd {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .pub {
      grid-template-columns: minmax(0, 1fr);
    }
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 560px) {
    .stats {
      gap: 1rem;
    }
    .stats dt {
      font-size: 2.1rem;
    }
    .stats div:not(:first-child) dt {
      font-size: 1.2rem;
      margin-top: 0.7rem;
    }
  }
</style>
